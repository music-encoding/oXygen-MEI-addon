<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.music-encoding</groupId>
  <artifactId>oXygen-MEI-addon</artifactId>
  <version>1.0.0-develop</version>

  <name>oXygen-MEI-addon</name>
  <!-- FIXME change it to the project's website -->
  <url>http://www.example.com</url>

  <packaging>pom</packaging>

  <developers>
    <developer>
      <name>Benjamin W. Bohl</name>
      <email>b.w.bohl@gmail.com</email>
      <roles>
        <role>manager</role>
      </roles>
    </developer>
  </developers>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <scm>
    <connection>scm:git:git://github.com/music-encoding/oXygen-MEI-addon.git</connection>
    <url>https://github.com/music-encoding/oXygen-MEI-addon</url>
  </scm>

  <repositories>
    <repository>
      <id>public</id>
      <name>oXygen public artifacts</name>
      <url>https://www.oxygenxml.com/maven</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <!--<modules>
    <module>target/generated-sources/verovio</module>
  </modules>-->

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.11.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Optionally: parameterized tests support -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
      <plugins>
        <!-- clean lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#clean_Lifecycle -->
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <!-- default lifecycle, jar packaging: see https://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_jar_packaging -->

        <!-- verovio -->
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
          <executions>
            <execution>
              <id>copy-verovio-submodule</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>copy-resources</goal>
              </goals>
              <configuration>
                <outputDirectory>target/generated-sources/verovio</outputDirectory>
                <resources>
                  <resource>
                    <directory>submodules/verovio</directory>
                    <excludes>
                      <exclude>java/example-mei/main.java</exclude>
                      <exclude>java/example-pae/**</exclude>
                    </excludes>
                  </resource>
                </resources>
              </configuration>
            </execution>

            <execution>
              <id>copy-verovio-src</id>
              <phase>process-sources</phase>
              <goals>
                <goal>copy-resources</goal>
              </goals>
              <configuration>
                <outputDirectory>target/generated-sources/verovio/bindings/java/example-mei</outputDirectory>
                <resources>
                  <resource>
                    <directory>src/verovio</directory>
                  </resource>
                </resources>
              </configuration>
            </execution>

            <!-- schema -->
            <execution>
              <id>copy-schema</id>
              <phase>process-resources</phase>
              <goals>
                <goal>copy-resources</goal>
              </goals>
              <configuration>
                <outputDirectory>target/extra-resources/schema</outputDirectory>
                <resources>
                  <resource>
                    <directory>submodules/schema</directory>
                    <includes>
                      <include>**/*.odd</include>
                      <include>**/*.rng</include>
                      <include>**/*.xml</include>
                      <include>**/*.xsd</include>
                    </includes>
                  </resource>
                </resources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        
        <!-- verovio -->
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <executions>
            <execution>
              <id>compile-verovio</id>
              <goals>
                <goal>compile</goal>
              </goals>
              <configuration>
                  <source>8</source>
                  <target>8</target>
                </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.3.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <!-- site lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#site_Lifecycle -->
        <plugin>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.12.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>

        <!-- additional -->
        <plugin>
          <artifactId>exec-maven-plugin</artifactId>
          <groupId>org.codehaus.mojo</groupId>
          <executions>
            <execution>
              <id>compile-verovio</id>
              <phase>compile</phase>
              <goals>
                <goal>exec</goal>
              </goals>
              <configuration>
                <executable>maven</executable>
                <workingDirectory>/target/generated-sources/verovio</workingDirectory>
                <arguments>
                  <argument>package</argument>
                </arguments>
              </configuration>
            </execution>
            <execution>
              <id>package-verovio</id>
              <phase>compile</phase>
              <goals>
                <goal>exec</goal>
              </goals>
              <configuration>
                <executable>mvn</executable>
                <workingDirectory>/target/generated-sources/verovio</workingDirectory>
                <arguments>
                  <argument>package</argument>
                </arguments>
              </configuration>
            </execution>
          </executions>
        </plugin>

      </plugins>



    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
    </plugins>



  </build>

</project>
